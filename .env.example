# ─────────────────────────────────────────────
# LUMIÈRE COLLECTION — AUTOMATION SYSTEM
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# ── AI PROVIDER (choose one — all are FREE) ─────────────────────────────────
# Set AI_PROVIDER to: groq | gemini | openrouter | ollama
AI_PROVIDER=groq

# GROQ (Recommended — free, fast, no credit card)
# Get key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GOOGLE GEMINI (free tier — 15 req/min)
# Get key at: https://aistudio.google.com
# GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-exp

# OPENROUTER (free models available)
# Get key at: https://openrouter.ai
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OLLAMA (completely local, no key needed)
# Install: https://ollama.ai — then: ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# SHOPIFY
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-04

# META (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_TOKEN=
META_TOKEN_CREATED_DATE=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# TIKTOK
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_APPROVED=false

# PINTEREST
PINTEREST_ACCESS_TOKEN=
PINTEREST_USERNAME=
PINTEREST_BOARD_NEW_ARRIVALS=
PINTEREST_BOARD_GIRLS=
PINTEREST_BOARD_BOYS=
PINTEREST_BOARD_BABY=

# GOOGLE AI STUDIO (VEO 3)
GOOGLE_AI_STUDIO_API_KEY=

# KLING AI (optional — prompt generation works without key)
KLING_API_KEY=

# REPLICATE (optional — Real-ESRGAN 4K upscaling)
REPLICATE_API_KEY=

# SYSTEM
OUTPUT_DIR=./output
QUEUE_DIR=./queue
TIMEZONE=Africa/Johannesburg
LOG_LEVEL=info
