# PINTEREST
PINTEREST_ACCESS_TOKEN=
PINTEREST_USERNAME=
PINTEREST_BOARD_NEW_ARRIVALS=
PINTEREST_BOARD_GIRLS=
PINTEREST_BOARD_BOYS=
PINTEREST_BOARD_BABY=

# GOOGLE AI STUDIO (VEO 3)
GOOGLE_AI_STUDIO_API_KEY=AIzaSyAU-EWDVYyQUl_lMEv8K4VpTXdlTSYs8KQ

# KLING AI (optional — prompt generation works without key)
KLING_API_KEY=BAGbKFYYKEhKNgrTCRppBrfmYBmnTtBk

# REPLICATE (optional — Real-ESRGAN 4K upscaling)
REPLICATE_API_KEY=r8_Hrw16fwRSairZqOy7uaGPH77ZHuACU933bwkc

# GOOGLE DRIVE (content delivery while social APIs are being set up)
# ── Setup guide ──────────────────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → Create project → Enable "Google Drive API"
# 2. IAM & Admin → Service Accounts → Create service account → Add JSON key → Download
# 3. Open Google Drive → create a folder called "Lumière Collection"
#    → Right-click → Share → paste the service account email (ends in @....iam.gserviceaccount.com)
#    → Give it "Editor" access
# 4. Copy the folder ID from the URL:
#    https://drive.google.com/drive/folders/  ← THIS PART IS THE ID
# 5. Set the three variables below and restart the server
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
# Option A — path to the downloaded JSON key file:
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
# Option B — paste the entire JSON on one line (escape quotes if needed):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# SYSTEM
OUTPUT_DIR=./output
QUEUE_DIR=./queue
TIMEZONE=Africa/Johannesburg
LOG_LEVEL=info
