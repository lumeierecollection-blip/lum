# ─────────────────────────────────────────────
# LUMIÈRE COLLECTION — AUTOMATION SYSTEM
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# ── AI PROVIDER (choose one — all are FREE) ─────────────────────────────────
# Set AI_PROVIDER to: cerebras | gemini | openrouter | ollama
AI_PROVIDER=cerebras

# CEREBRAS (Recommended — free tier, extremely fast inference)
# Get key at: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama-3.3-70b

# GOOGLE GEMINI (free tier — 15 req/min)
# Get key at: https://aistudio.google.com
# GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-exp

# OPENROUTER (free models available)
# Get key at: https://openrouter.ai
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OLLAMA (completely local, no key needed)
# Install: https://ollama.ai — then: ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# SHOPIFY
SHOPIFY_STORE_DOMAIN=lumeire-collection.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=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
SHOPIFY_API_VERSION=2026-04

# META (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_TOKEN=
META_TOKEN_CREATED_DATE=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# TIKTOK
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
