# ─────────────────────────────────────────────
# LUMIÈRE COLLECTION — AUTOMATION SYSTEM
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# ANTHROPIC — set ONE of these:
# Standard API key (sk-ant-api-...): use ANTHROPIC_API_KEY
# OAuth/session token (sk-ant-si-...): use ANTHROPIC_AUTH_TOKEN
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# SHOPIFY
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-04

# META (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_TOKEN=
META_TOKEN_CREATED_DATE=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# TIKTOK
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_APPROVED=false

# PINTEREST
PINTEREST_ACCESS_TOKEN=
PINTEREST_USERNAME=
PINTEREST_BOARD_NEW_ARRIVALS=
PINTEREST_BOARD_GIRLS=
PINTEREST_BOARD_BOYS=
PINTEREST_BOARD_BABY=

# GOOGLE AI STUDIO (VEO 3)
GOOGLE_AI_STUDIO_API_KEY=

# KLING AI (optional — prompt generation works without key)
KLING_API_KEY=

# REPLICATE (optional — Real-ESRGAN 4K upscaling)
REPLICATE_API_KEY=

# SYSTEM
OUTPUT_DIR=./output
QUEUE_DIR=./queue
TIMEZONE=Africa/Johannesburg
LOG_LEVEL=info
